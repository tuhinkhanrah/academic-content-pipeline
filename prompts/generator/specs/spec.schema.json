{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/academic-content-pipeline/spec.schema.json",
  "title": "Academic Content Generation Specification",
  "description": "Reference schema for generate-questions and generate-paper JSON specifications. MCQ type values refer to names or IDs in ../mcq_types.json. Tags use the form namespace:value, for example year:2026 or lang:bn.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "description": "Specification schema version."},
    "exam_name": {"type": "string", "minLength": 1},
    "paper_title": {"type": "string", "minLength": 1},
    "duration_minutes": {"type": "integer", "exclusiveMinimum": 0},
    "total_marks": {"type": "number", "minimum": 0},
    "total_questions": {"type": "integer", "minimum": 0},
    "marks_per_question": {"type": "number", "minimum": 0},
    "batch_size": {"type": "integer", "minimum": 1},
    "tags": {"$ref": "#/$defs/tags"},
    "instructions": {"$ref": "#/$defs/stringList"},
    "paper_instructions": {"$ref": "#/$defs/stringList"},
    "generation_instructions": {"$ref": "#/$defs/stringList"},
    "global_instructions": {"$ref": "#/$defs/stringList"},
    "header_fields": {"$ref": "#/$defs/headerFields"},
    "exam": {"$ref": "#/$defs/exam"},
    "candidate_fields": {
      "type": "array",
      "description": "Candidate fields to render in the paper header.",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "uniqueItems": true
    },
    "instruction_profile": {"$ref": "#/$defs/instructionProfile"},
    "generation_policy": {"$ref": "#/$defs/generationPolicy"},
    "calibration": {"$ref": "#/$defs/calibration"},
    "question_types": {
      "description": "Question type allocation. A list is shorthand for exact mode.",
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/questionTypeAllocation"}},
        {"$ref": "#/$defs/questionTypeConfig"}
      ]
    },
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "subjects": {"type": "array", "items": {"$ref": "#/$defs/subject"}}
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tags": {
      "description": "Tags supplied to generated content. Each tag should be namespace:value or a plain non-empty tag.",
      "oneOf": [
        {"type": "string", "pattern": "^\\S+$"},
        {"type": "array", "items": {"type": "string", "pattern": "^\\S+$"}, "uniqueItems": true}
      ]
    },
    "headerFields": {
      "type": "object",
      "description": "Map of candidate-field keys to their initial/default values.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "name": {"type": "string", "minLength": 1},
        "paper_name": {"type": "string", "minLength": 1},
        "duration_minutes": {"type": "integer", "exclusiveMinimum": 0},
        "total_marks": {"type": "number", "minimum": 0}
      }
    },
    "instructionProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exam": {"$ref": "#/$defs/exam"},
        "global_instructions": {"$ref": "#/$defs/stringList"},
        "generation_policy": {"$ref": "#/$defs/generationPolicy"},
        "calibration": {"$ref": "#/$defs/calibration"},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}}
      }
    },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_count_mode": {"enum": ["exact", "weighted", "automatic"]},
        "prefer_quality_over_quantity": {"type": "boolean"},
        "allow_fewer_questions_if_source_is_weak": {"type": "boolean"},
        "require_standalone_questions": {"type": "boolean"},
        "require_solution": {"type": "boolean"},
        "require_multi_concept_question": {"type": "boolean"},
        "randomize_options": {"type": "boolean"},
        "vary_correct_option_position": {"type": "boolean"},
        "allow_question_type_substitution": {"type": "boolean"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {"$ref": "#/$defs/stringList"},
        "calculation_level": {"type": "string"},
        "distractor_quality": {"type": "string"},
        "avoid": {"$ref": "#/$defs/stringList"}
      }
    },
    "questionTypeAllocation": {
      "type": "object",
      "required": ["type", "count"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1, "description": "MCQ registry name or stable ID."},
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "weightedQuestionTypeAllocation": {
      "type": "object",
      "required": ["type", "weight"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "questionTypeConfig": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["exact", "weighted", "automatic"]},
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/questionTypeAllocation"},
              {"$ref": "#/$defs/weightedQuestionTypeAllocation"}
            ]
          }
        },
        "allowed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "minimum": {
          "type": "object",
          "propertyNames": {"type": "string"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "exact"}}}, "then": {"required": ["types"]}},
        {"if": {"properties": {"mode": {"const": "weighted"}}}, "then": {"required": ["types"]}},
        {"if": {"properties": {"mode": {"const": "automatic"}}}, "then": {"required": ["allowed"]}}
      ]
    },
    "section": {
      "type": "object",
      "required": ["id", "name", "question_count", "question_types", "scoring"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "name": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1, "description": "Subject name or all."},
        "question_count": {"type": "integer", "minimum": 0},
        "attempt_count": {"type": ["integer", "string"], "minimum": 0},
        "question_number_start": {"type": "integer", "minimum": 1},
        "question_number_end": {"type": "integer", "minimum": 1},
        "question_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/questionTypeAllocation"}},
        "scoring": {"$ref": "#/$defs/scoring"},
        "answer_format": {"$ref": "#/$defs/answerFormat"}
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correct": {"type": "number"},
        "incorrect": {"type": "number"},
        "unanswered": {"type": "number"},
        "partial": {"type": "boolean"},
        "partial_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "answerFormat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["numeric", "text", "choice", "multiple_choice"]},
        "decimal_places": {"type": "integer", "minimum": 0},
        "rounding": {"enum": ["truncate", "round"]}
      }
    },
    "subject": {
      "type": "object",
      "required": ["name", "total_questions", "syllabus_file"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "total_questions": {"type": "integer", "minimum": 0},
        "marks_per_question": {"type": "number", "minimum": 0},
        "default_grade": {"type": "number", "minimum": 0},
        "penalty": {"type": "number"},
        "negative_marks": {"type": "number"},
        "negative_fraction": {"type": "number"},
        "syllabus_file": {"type": "string", "minLength": 1}
      }
    }
  }
}
