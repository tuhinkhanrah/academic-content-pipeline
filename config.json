{
  "input_dir": "./pdfs",
  "output_dir": "./output",
  "prompt": "./prompts/prompt_neet_bilingual.md",
  "instruction_page": 1,
  "page_range": [2, 46],
  "standards": "NEET",
  "agent_name": "antigravity-preview-05-2026",
  "agent_config": {
    "type": "antigravity",
    "model": "gemini-3.6-flash"
  },
  "padding_cm": 0.5,
  "attempt_limit": 10,
  "rate_limit_delay": 45.0,
  "retry_base_delay": 4.0,
  "context_reset_interval": 7,
  "dpi": 150,
  "log_file": "./logs/pdf2moodle_agent.log",
  "verbose": true
}
